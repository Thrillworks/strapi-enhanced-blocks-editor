{
  "version": "1.0.1",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@strapi/admin": "^5.48.0",
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.48.0",
    "@strapi/typescript-utils": "^5.48.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.4",
    "slate": "^0.94.1",
    "slate-history": "^0.93.0",
    "slate-react": "^0.98.3",
    "styled-components": "^6.4.2",
    "typescript": "^5.9.3",
    "yup": "^0.32.9"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.27.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "enhanced-blocks-editor",
    "displayName": "Enhanced Blocks Editor",
    "description": "This plugin allows authors to embed other entries into Strapi's block editor "
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-rich-text-blocks",
    "thrillworks"
  ],
  "engines": {
    "node": ">=20.0.0 <=24.x.x"
  },
  "name": "@thrillworksinc/strapi-enhanced-blocks-editor",
  "description": "This plugin allows authors to embed other entries into Strapi's block editor ",
  "license": "MIT",
  "author": "Thrillworks"
}
